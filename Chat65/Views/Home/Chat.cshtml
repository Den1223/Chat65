@{
    ViewData["Title"] = "Чат";
}

<div class="chat-container d-flex">
    <!-- Ліва панель -->
    <div class="sidebar p-3">
        <h5>Онлайн користувачі</h5>
        <ul id="userList" class="list-group"></ul>
    </div>

    <!-- Основне вікно -->
    <div class="chat-window p-3 flex-grow-1 d-flex flex-column">

        <ul id="messagesList" class="chat-messages flex-grow-1"></ul>

        <input id="userInput" class="form-control mt-2" placeholder="Ваше ім'я" />
        <input id="messageInput" class="form-control mt-2" placeholder="Ваше повідомлення" />
        <button id="sendButton" class="btn btn-primary w-100 mt-2">Відправити</button>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/ChatHub")
            .build();

        const messagesList = document.getElementById("messagesList");
        const userList = document.getElementById("userList");
        let currentUser = "";

        // ============================
        // 1. Отримання історії чату
        // ============================
        connection.on("LoadHistory", (messages) => {
            messagesList.innerHTML = "";
            messages.forEach(m => addMessage(m.user, m.text));
        });

        // ============================
        // 2. Нове повідомлення
        // ============================
        connection.on("ReceiveMessage", (user, message) => {
            addMessage(user, message);
        });

        function addMessage(user, message) {
            const li = document.createElement("li");
            li.classList.add("message");

            if (user === currentUser) li.classList.add("user");
            else li.classList.add("other");

            li.innerHTML = `
                <strong>${user}:</strong>
                <span>${message}</span>
            `;

            messagesList.appendChild(li);
            messagesList.scrollTop = messagesList.scrollHeight;
        }

        // ============================
        // 3. Список користувачів
        // ============================
        connection.on("UpdateUserList", (users) => {
            userList.innerHTML = "";
            users.forEach(user => {
                const li = document.createElement("li");
                li.classList.add("list-group-item");
                li.textContent = user;
                userList.appendChild(li);
            });
        });

        // ============================
        // 4. Підключення до хабу
        // ============================
        connection.start()
            .then(() => console.log("SignalR connected"))
            .catch(err => console.error("SignalR error: " + err));

        // ============================
        // 5. Введення імені
        // ============================
        document.getElementById("userInput").addEventListener("blur", () => {
            const user = document.getElementById("userInput").value.trim();
            if (user && user !== currentUser) {
                currentUser = user;

                connection.invoke("JoinChat", user)
                    .catch(err => console.error(err));
            }
        });

        // ============================
        // 6. Надсилання повідомлень
        // ============================
        document.getElementById("sendButton").addEventListener("click", () => {
            const message = document.getElementById("messageInput").value.trim();
            if (!currentUser) { alert("Введіть ім'я!"); return; }

            if (message) {
                connection.invoke("SendMessage", currentUser, message)
                    .catch(err => console.error(err));

                document.getElementById("messageInput").value = "";
            }
        });
    </script>

    <style>
        .chat-container {
            height: 80vh;
        }

        .sidebar {
            width: 250px;
            background: #f8f9fa;
            border-right: 1px solid #ddd;
        }

        .chat-window {
            display: flex;
            flex-direction: column;
        }

        .chat-messages {
            list-style: none;
            padding: 0;
            margin: 0;
            overflow-y: auto;
            flex-grow: 1;
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 10px;
            background: #ffffff;
        }

        .message {
            margin-bottom: 10px;
            padding: 8px 12px;
            border-radius: 10px;
            max-width: 70%;
        }

        .message.user {
            background: #cfe9ff;
            align-self: flex-end;
        }

        .message.other {
            background: #e9ecef;
            align-self: flex-start;
        }
    </style>
}
