@{
    ViewData["Title"] = "Чат";
}

<link rel="stylesheet" href="~/css/chat.css?v=@DateTime.Now.Ticks" />
<script src="~/js/chat.js?v=@DateTime.Now.Ticks"></script>


<div class="chat-container">
    <div class="sidebar">
        <h5>Онлайн користувачі</h5>
        <ul id="userList" class="list-group"></ul>
    </div>
    <div class="chat-window">
        <ul id="messagesList"></ul>

        <input id="userInput" class="form-control" placeholder="Ваше ім'я" />
        <input id="messageInput" class="form-control" placeholder="Ваше повідомлення" />
        <button id="sendButton" class="btn btn-primary w-100 mt-2">Відправити</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat.js"></script>
}
